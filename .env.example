# Salin ke .env lalu sesuaikan. File .env tidak masuk git.
# Dibaca oleh ecosystem.config.cjs saat: pm2 startOrReload ecosystem.config.cjs --update-env

# Alamat server Node. 127.0.0.1 = hanya bisa diakses lewat reverse proxy (nginx/Caddy).
HOST=0.0.0.0
PORT=4455

# IP asli pengunjung dari header reverse proxy.
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1

# Detik menunggu koneksi aktif selesai saat restart. Harus < kill_timeout PM2 (10 detik).
SHUTDOWN_TIMEOUT=8

# Batas ukuran body request.
BODY_SIZE_LIMIT=512K
